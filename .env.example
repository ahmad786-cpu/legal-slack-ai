# --- Slack (from your Slack app; see README) ---
# OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information > App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...

# --- AI models ---
# Free setup (default): chat on Groq, embeddings from Pinecone's hosted model.
# Paid setup: set OPENAI_API_KEY, leave LLM_BASE_URL/LLM_API_KEY empty and use OpenAI model names.

# Chat, analysis and drafts (any OpenAI-compatible endpoint)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Reads text from images; must accept image input
VISION_MODEL=qwen/qwen3.8-27b

# Embeddings: "pinecone" (free, llama-text-embed-v2, 1024 dims) or "openai" (needs OPENAI_API_KEY)
EMBED_PROVIDER=pinecone
OPENAI_API_KEY=

# Prompt sizes; the defaults fit free-tier rate limits (about 8,000 tokens a minute)
ANALYSIS_CHARS=16000
SEARCH_TOP_K=5
DRAFT_MAX_TOKENS=2500

# --- Pinecone (vector database) ---
PINECONE_API_KEY=
# Created automatically on first start if it does not exist (dimension matches the embedding model)
PINECONE_INDEX=legal-slack
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Google Calendar (optional) ---
# The calendar's ID (Calendar settings > Integrate calendar > Calendar ID)
GOOGLE_CALENDAR_ID=
# Path to the service account key file, or paste the JSON on one line instead
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Timezone for dates and events, e.g. Asia/Karachi or America/New_York
TIMEZONE=UTC

# Where the document list and matter briefs are kept
DATA_FILE=./data/store.json
MAX_FILE_MB=25
