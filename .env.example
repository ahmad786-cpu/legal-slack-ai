# --- Slack (from your Slack app; see README) ---
# OAuth & Permissions > Bot User OAuth Token
SLACK_BOT_TOKEN=xoxb-...
# Basic Information > App-Level Tokens (scope: connections:write)
SLACK_APP_TOKEN=xapp-...

# --- OpenAI: embeddings (and, by default, chat and image reading) ---
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIMENSIONS=1536

# Chat model for analysis, answers and drafts: any model your account offers, e.g. a GPT model name.
LLM_MODEL=
# Optional: another OpenAI-compatible provider for chat (embeddings stay on OpenAI)
LLM_BASE_URL=
LLM_API_KEY=
# Model that reads text from images; must accept image input. Defaults to LLM_MODEL.
VISION_MODEL=

# --- Pinecone (vector database) ---
PINECONE_API_KEY=
# Created automatically on first start if it does not exist
PINECONE_INDEX=legal-slack
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- Google Calendar (optional) ---
# The calendar's ID (Calendar settings > Integrate calendar > Calendar ID)
GOOGLE_CALENDAR_ID=
# Path to the service account key file, or paste the JSON on one line instead
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Timezone for dates and events, e.g. Asia/Karachi or America/New_York
TIMEZONE=UTC

# Where the document list and matter briefs are kept
DATA_FILE=./data/store.json
MAX_FILE_MB=25
